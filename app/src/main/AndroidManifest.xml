<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 新しく撮った写真を調べる -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- レシートを見つけたら通知する -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 省電力機能で写真の確認が止まらないよう、対象外にするよう求める -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Claude アプリを開けるか確認するため -->
    <queries>
        <package android:name="com.anthropic.claude" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReceiptKakeibo"
        tools:targetApi="35">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 通知から Claude を開くための、画面を持たない中継役 -->
        <activity
            android:name=".ui.SendActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ReceiptKakeibo.Transparent" />

        <receiver
            android:name=".scan.NotReceiptReceiver"
            android:exported="false" />

        <!-- 向きを直した画像を Claude アプリに渡すため -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
